    }
    init { () }
    next(state: ()) { () }
}

#[test_proc]
proc Systolic4Test {
    terminator: chan<bool> out;
    in_s: chan<ArrIn> out;
    out_r: chan<s32[4]> in;
    config(terminator: chan<bool> out) {
        let (in_s, in_r) = chan<ArrIn>("in");
        let (out_s, out_r) = chan<s32[4]>("out");
        spawn Systolic4(in_r, out_s);
        (terminator, in_s, out_r)
    }
    init { () }
    next(state: ()) {
        let tok = send(join(), in_s, ArrIn { load: true, row: u2:0, x: s8[4]:[1, -2, 3, -4] });
        let tok = send(tok, in_s, ArrIn { load: true, row: u2:1, x: s8[4]:[-5, 6, -7, 8] });
        let tok = send(tok, in_s, ArrIn { load: true, row: u2:2, x: s8[4]:[9, -10, 11, -12] });
        let tok = send(tok, in_s, ArrIn { load: true, row: u2:3, x: s8[4]:[-13, 14, -15, 16] });
        let tok = send(tok, in_s, ArrIn { load: false, row: u2:0, x: s8[4]:[1, -2, 3, -4] });
        let tok = send(tok, in_s, ArrIn { load: false, row: u2:0, x: s8[4]:[-128, 127, 127, 127] });
        let (tok, y) = recv(tok, out_r);
        assert_eq(y, s32[4]:[90, -100, 110, -120]);
        let (tok, y) = recv(tok, out_r);
        assert_eq(y, s32[4]:[-1271, 1526, -1781, 2036]);
        send(tok, terminator, true);
    }
}
