        let (north_s, north_r) = chan<s32, FIFO_DEPTH>[4]("north_edge");
        let (ew_s, ew_r) = chan<s8, FIFO_DEPTH>[12]("east_west");
        let (ns_s, ns_r) = chan<s32, FIFO_DEPTH>[12]("north_south");
        let (south_s, south_r) = chan<s32, FIFO_DEPTH>[4]("south_edge");
        let (emit_s, emit_r) = chan<bool, FIFO_DEPTH>("emit");
        spawn Distributor(in_r, ctl_s, west_s, north_s, emit_s);
        spawn NodeE(ctl_r[0], west_r[0], north_r[0], ew_s[0], ns_s[0]);
        spawn NodeE(ctl_r[1], ew_r[0], north_r[1], ew_s[4], ns_s[1]);
        spawn NodeE(ctl_r[2], ew_r[4], north_r[2], ew_s[8], ns_s[2]);
        spawn NodeLast(ctl_r[3], ew_r[8], north_r[3], ns_s[3]);
        spawn NodeE(ctl_r[4], west_r[1], ns_r[0], ew_s[1], ns_s[4]);
        spawn NodeE(ctl_r[5], ew_r[1], ns_r[1], ew_s[5], ns_s[5]);
        spawn NodeE(ctl_r[6], ew_r[5], ns_r[2], ew_s[9], ns_s[6]);
        spawn NodeLast(ctl_r[7], ew_r[9], ns_r[3], ns_s[7]);
        spawn NodeE(ctl_r[8], west_r[2], ns_r[4], ew_s[2], ns_s[8]);
        spawn NodeE(ctl_r[9], ew_r[2], ns_r[5], ew_s[6], ns_s[9]);
        spawn NodeE(ctl_r[10], ew_r[6], ns_r[6], ew_s[10], ns_s[10]);
        spawn NodeLast(ctl_r[11], ew_r[10], ns_r[7], ns_s[11]);
        spawn NodeE(ctl_r[12], west_r[3], ns_r[8], ew_s[3], south_s[0]);
        spawn NodeE(ctl_r[13], ew_r[3], ns_r[9], ew_s[7], south_s[1]);
        spawn NodeE(ctl_r[14], ew_r[7], ns_r[10], ew_s[11], south_s[2]);
        spawn NodeLast(ctl_r[15], ew_r[11], ns_r[11], south_s[3]);
        spawn Collector(south_r, emit_r, out_s);
