        let k0_1 = send(tok, ctls[1], NodeCtl { load: m.load && m.row == u1:0, w: m.x[1] });
        let k1_0 = send(tok, ctls[2], NodeCtl { load: m.load && m.row == u1:1, w: m.x[0] });
        let k1_1 = send(tok, ctls[3], NodeCtl { load: m.load && m.row == u1:1, w: m.x[1] });
        let a0 = send(tok, wests[0], m.x[0]);
        let a1 = send(tok, wests[1], m.x[1]);
        let z0 = send(tok, norths[0], s32:0);
        let z1 = send(tok, norths[1], s32:0);
        let tok = join(k0_0, k0_1, k1_0, k1_1, a0, a1, z0, z1);
        send(tok, emit, !m.load);
    }
}

proc Collector {
    souths: chan<s32>[2] in;
    emit: chan<bool> in;
    out_s: chan<s32[2]> out;
