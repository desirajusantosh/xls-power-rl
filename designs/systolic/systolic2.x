proc NodeE {
    ctl: chan<NodeCtl> in;
    west: chan<s8> in;
    north: chan<s32> in;
    east: chan<s8> out;
    south: chan<s32> out;
    config(ctl: chan<NodeCtl> in, west: chan<s8> in, north: chan<s32> in, east: chan<s8> out, south: chan<s32> out) { (ctl, west, north, east, south) }
    // State: (weight, last activation fed to the multiplier).
    init { (s8:0, s8:0) }
    next(state: (s8, s8)) {
        let (w, last_a) = state;
        let (t0, c) = recv(join(), ctl);
        let (t1, a) = recv(join(), west);
        let (t2, ps) = recv(join(), north);
        let tok = join(t0, t1, t2);
        let a_mul = a;
        let sum = ps + (a_mul as s32) * (w as s32);
        let te = send(tok, east, a);
        send(te, south, sum);
        (if c.load { c.w } else { w }, a_mul)
    }
}

