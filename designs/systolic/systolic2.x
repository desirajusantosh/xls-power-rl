        let tok = join(t, ts0, ts1);
        send_if(tok, out_s, e, s32[2]:[y0, y1]);
    }
}

pub proc Systolic2 {
    config(in_r: chan<ArrIn> in, out_s: chan<s32[2]> out) {
        let (ctl_s, ctl_r) = chan<NodeCtl, FIFO_DEPTH>[4]("ctl");
        let (west_s, west_r) = chan<s8, FIFO_DEPTH>[2]("west_edge");
        let (north_s, north_r) = chan<s32, FIFO_DEPTH>[2]("north_edge");
        let (ew_s, ew_r) = chan<s8, FIFO_DEPTH>[2]("east_west");
        let (ns_s, ns_r) = chan<s32, FIFO_DEPTH>[2]("north_south");
        let (south_s, south_r) = chan<s32, FIFO_DEPTH>[2]("south_edge");
        let (emit_s, emit_r) = chan<bool, FIFO_DEPTH>("emit");
        spawn Distributor(in_r, ctl_s, west_s, north_s, emit_s);
        spawn NodeE(ctl_r[0], west_r[0], north_r[0], ew_s[0], ns_s[0]);
        spawn NodeLast(ctl_r[1], ew_r[0], north_r[1], ns_s[1]);
        spawn NodeE(ctl_r[2], west_r[1], ns_r[0], ew_s[1], south_s[0]);
        spawn NodeLast(ctl_r[3], ew_r[1], ns_r[1], south_s[1]);
        spawn Collector(south_r, emit_r, out_s);
        ()
    }
    init { () }
    next(state: ()) { () }
}

#[test_proc]
proc Systolic2Test {
    terminator: chan<bool> out;
    in_s: chan<ArrIn> out;
    out_r: chan<s32[2]> in;
    config(terminator: chan<bool> out) {
        let (in_s, in_r) = chan<ArrIn>("in");
        let (out_s, out_r) = chan<s32[2]>("out");
        spawn Systolic2(in_r, out_s);
        (terminator, in_s, out_r)
    }
    init { () }
    next(state: ()) {
        let tok = send(join(), in_s, ArrIn { load: true, row: u1:0, x: s8[2]:[1, -2] });
        let tok = send(tok, in_s, ArrIn { load: true, row: u1:1, x: s8[2]:[-3, 4] });
        let tok = send(tok, in_s, ArrIn { load: false, row: u1:0, x: s8[2]:[1, -2] });
        let tok = send(tok, in_s, ArrIn { load: false, row: u1:0, x: s8[2]:[-128, 127] });
        let (tok, y) = recv(tok, out_r);
        assert_eq(y, s32[2]:[7, -10]);
        let (tok, y) = recv(tok, out_r);
        assert_eq(y, s32[2]:[-509, 764]);
        send(tok, terminator, true);
    }
}
